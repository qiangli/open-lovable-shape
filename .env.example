# Required: the owner's configured OpenAI-compatible gateway or provider.
OPENAI_COMPATIBLE_BASE_URL=http://gateway.example.invalid/v1
OPENAI_COMPATIBLE_MODEL=owner-model
# Optional when the gateway authenticates requests.
# OPENAI_COMPATIBLE_API_KEY=

# Local sandbox; executed through `bashy oci` (Podman).
SANDBOX_PROVIDER=bashy-oci
# BASHY_BIN=bashy
# SANDBOX_IMAGE=docker.io/library/node:22-alpine

# Site cloning is optional and remains off unless both values are set.
ENABLE_FIRECRAWL=false
# FIRECRAWL_API_KEY=
